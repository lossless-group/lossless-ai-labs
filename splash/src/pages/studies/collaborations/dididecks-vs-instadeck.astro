  { idea: 'People and companies as data', ours: '/data-assets/* routes, crawl-fetch-ingest', pack: 'Carried over', them: 'Changed: “real people remain real” as an acceptance check', kind: 'changed' },
  { idea: 'Gated access to private decks', ours: 'Reader gating per deck site', pack: 'Carried over', them: 'Changed: author accounts and workspaces', kind: 'changed' },
  { idea: 'Frontend and backend split', ours: 'Her architecture doc inside dididecks-ai', pack: 'Carried over', them: 'Built: SvelteKit plus FastAPI on Railway', kind: 'carried' },
  { idea: 'Storage', ours: 'Filesystem as database', pack: 'Changed: “a database-backed deck operating system”', them: 'Postgres, records per operation', kind: 'changed' },
  { idea: 'Business fields', ours: 'None', pack: 'New: blocks bound to persistent fields, rebuild jobs', them: 'Not in Instant Deck’s canonical path', kind: 'new' },
  { idea: 'Authoring method', ours: 'Holistic first, Markdown narratives, DESIGN.md', pack: 'Not in the pack', them: 'Re-converged: the Markdown document chain and 06-DESIGN.md', kind: 'reconverged' },
  { idea: 'Memory', ours: 'context-v, changelogs, prior sessions', pack: 'Not in the pack', them: 'Changed on purpose: operation-scoped database records', kind: 'changed' },
  { idea: 'Agents', ours: 'Claude Code, skills', pack: 'Codex prompts, one at a time', them: 'Codex for dev; OpenAI for the product; 19 product SKILL.md', kind: 'changed' },
];
---

<BaseLayout
  title="Dididecks vs Instadeck"
  description="Two deck generators from one lineage, compared layer by layer: dididecks-ai generates decks inside a Claude Code session, Instadeck inside a server pipeline. Not a ranking: what each approach makes easier and harder for agents and users."
>
  <div class="dvi" data-pagefind-body>
