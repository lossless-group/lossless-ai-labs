    <!-- 7 · The four comparisons, by layer ──────────────────────────── -->
    <section class="buckets" id="ch-buckets" aria-labelledby="dvi-buckets">
      <div class="container">
        <p class="eyebrow">ch · the four comparisons</p>
        <h2 id="dvi-buckets">Shared, similar, different, missing, by layer</h2>
        <p class="section-lede">Every artifact from both inventories sits in exactly one row, and no row pairs across layers: {DEV_ROWS} rows in the developer layer, {PRODUCT_ROWS} in the in-product layer.</p>

        {BUCKETS.map((b) => (
          <article class="bucket" id={b.key}>
            <header class="bucket__head">
              <h3>{b.label}</h3>
              <span class="bucket__badge"><span class={`swatch swatch--${b.key}`} aria-hidden="true"></span>dev {b.dev} of {DEV_ROWS} · product {b.product} of {PRODUCT_ROWS}</span>
            </header>
            <div class="minibars" aria-hidden="true">
