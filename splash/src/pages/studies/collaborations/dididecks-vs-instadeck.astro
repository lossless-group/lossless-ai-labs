                    <span class="lm__who">Instadeck · {L.name.replace(' harness', '')}</span>
                    <span class="lm__depth">
                      <span class="lm__meter" aria-hidden="true">{[1, 2, 3].map((n) => <span class={n <= L.them.depth.level ? 'on' : ''}></span>)}</span>
