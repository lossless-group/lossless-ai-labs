                    <div class={`lm__arrow lm__arrow--${a.dir} ${a.main ? 'lm__arrow--main' : 'lm__arrow--minor'}`}>
                      <svg viewBox="0 0 100 24" aria-hidden="true" focusable="false">
                        {a.dir === 'right'
                          ? <path d="M4 12 H90 M80 4 L92 12 L80 20" />
                          : <path d="M96 12 H10 M20 4 L8 12 L20 20" />}
