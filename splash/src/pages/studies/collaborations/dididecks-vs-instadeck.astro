type Comp = { id: string; type: string; label: string; sublabel?: string; pos: number[] };
type MapDoc = { meta: { legend: { entries: Record<string, { label: string }> } }; components: Comp[]; connections: { from: string; to: string; label?: string }[] };
function stackFrom(doc: MapDoc) {
  const rows = new Map<number, { y: number; category: string; ours?: Comp; them?: Comp; bucket: string }>();
  for (const c of doc.components) {
    const y = c.pos[1];
    const row = rows.get(y) ?? { y, category: doc.meta.legend.entries[c.type]?.label ?? '', bucket: 'different, no counterpart' };
    if (c.id.startsWith('l-')) row.ours = c;
    else row.them = c;
    rows.set(y, row);
  }
  for (const k of doc.connections) {
    const from = doc.components.find((c) => c.id === k.from);
    if (from) rows.get(from.pos[1])!.bucket = k.label ?? '';
  }
  const pairs = [...rows.values()].sort((a, b) => a.y - b.y);
  return [...new Set(pairs.map((p) => p.category))].map((cat) => ({ cat, rows: pairs.filter((p) => p.category === cat) }));
}
