  }

  /* ─── Additions for this page ─────────────────────────────────────── */
  .notranking { max-width: 62rem; font-size: 0.9rem; color: var(--color-text-dim); border: 1px dashed var(--color-border-strong); border-radius: var(--radius-md); padding: var(--space-3) var(--space-4); margin: 0; }
  .notranking strong { color: var(--color-text-soft); }
  @media (min-width: 52.01rem) { .lm__grid { grid-template-columns: 11rem minmax(0, 1fr) 10rem minmax(0, 1fr); } }
  .lm__arrows { display: grid; align-content: center; gap: var(--space-5); }
  .lm__arrow--minor path { stroke-width: 1.5; stroke-dasharray: 5 4; }
  .lm__arrow--minor .lm__arrowlabel { opacity: 0.85; }
  .lm__arrow--main .lm__arrowlabel { font-weight: 600; }
  @media (max-width: 52rem) {
    .lm__arrows { grid-template-columns: 1fr 1fr; gap: var(--space-3); }
    .lm__arrows .lm__arrow svg { transform: none; width: 100%; height: 1.4rem; }
  }
  .stories { display: grid; gap: var(--space-5); grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); margin-top: var(--space-8); }
  .stories .prototype { margin-top: 0; }
  .prototype--thread { border-left-color: var(--color-thread); }
  .swatch--plain { border-top: 1.5px solid var(--color-text-dim); }
  .stack__card-sub { margin-top: var(--space-4) !important; color: var(--color-text-soft) !important; }
  .timeline { list-style: none; display: grid; gap: 0; margin: 0 0 var(--space-8); padding: 0; border-left: 2px solid var(--color-border-strong); max-width: 64rem; }
  .timeline__item { position: relative; display: grid; grid-template-columns: 8.5rem 7rem minmax(0, 1fr); gap: var(--space-1) var(--space-4); padding: var(--space-3) 0 var(--space-3) var(--space-5); }
  .timeline__item::before { content: ''; position: absolute; left: -7px; top: 1.05rem; width: 12px; height: 12px; border-radius: 50%; background: var(--color-bg); border: 2px solid var(--color-text-dim); }
  .timeline__item--ours::before { border-color: var(--color-accent); background: var(--color-accent); }
  .timeline__item--them::before { border-color: var(--color-signal); background: var(--color-signal); }
  .timeline__item--both::before { border-color: var(--color-thread); background: var(--color-bg); }
  .timeline__date { font-family: var(--font__mono); font-size: 0.78rem; color: var(--color-text); font-variant-numeric: tabular-nums; }
  .timeline__side { font-family: var(--font__mono); font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-dim); }
  .timeline__item--ours .timeline__side { color: var(--color-accent); }
  .timeline__item--them .timeline__side { color: var(--color-signal); }
  .timeline__item--both .timeline__side { color: var(--color-thread); }
  .timeline__t { color: var(--color-text); }
  .timeline__d { grid-column: 3; color: var(--color-text-soft); font-size: 0.9rem; }
  @media (max-width: 40rem) {
    .timeline__item { grid-template-columns: minmax(0, 1fr); }
    .timeline__d { grid-column: 1; }
  }
  .lineage__table { min-width: 52rem; }
  .lineage__table tbody th { white-space: normal; min-width: 9rem; }
  .lineage__row--reconverged td:last-child { color: var(--color-text); font-weight: 600; }
</style>

<style is:global>
  /* ─── Archify class → splash token mapping ───────────────────────────
     Archify emits semantic classes; these rules bind them to theme.css
     tokens so the diagrams follow dark / light / vibrant. Category hues:
     instructions = thread, config = signal, context = accent,
     verification = neutral, git = accent-deep, people/shape = dim. */
  .dvi-svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font__mono);
    --k-frontend: var(--color-thread);
    --k-security: var(--color-signal);
    --k-database: var(--color-accent);
    --k-backend: var(--color-text-soft);
    --k-messagebus: var(--color-accent-deep);
    --k-external: var(--color-text-dim);
    --k-cloud: var(--color-text-soft);
  }
  .dvi-svg .c-grid { display: none; }
  .dvi-svg .c-mask { fill: var(--color-bg-elevated); stroke: none; }
  .dvi-svg .c-region { fill: color-mix(in oklab, var(--color-text) 3%, transparent); stroke: var(--color-border-strong); stroke-dasharray: 8 4; }
  .dvi-svg .c-security-group { fill: transparent; stroke: var(--k-security); stroke-dasharray: 4 4; }
  .dvi-svg .c-lane { fill: color-mix(in oklab, var(--color-text) 3%, transparent); stroke: var(--color-border-strong); stroke-dasharray: 6 6; }

  .dvi-svg .c-frontend   { fill: color-mix(in oklab, var(--k-frontend) 14%, var(--color-bg-elevated));   stroke: var(--k-frontend); }
  .dvi-svg .c-security   { fill: color-mix(in oklab, var(--k-security) 14%, var(--color-bg-elevated));   stroke: var(--k-security); }
  .dvi-svg .c-database   { fill: color-mix(in oklab, var(--k-database) 14%, var(--color-bg-elevated));   stroke: var(--k-database); }
  .dvi-svg .c-backend    { fill: color-mix(in oklab, var(--k-backend) 10%, var(--color-bg-elevated));    stroke: var(--k-backend); }
  .dvi-svg .c-messagebus { fill: color-mix(in oklab, var(--k-messagebus) 16%, var(--color-bg-elevated)); stroke: var(--k-messagebus); }
  .dvi-svg .c-external   { fill: var(--color-bg-elevated); stroke: var(--k-external); }
  .dvi-svg .c-cloud      { fill: var(--color-bg-elevated); stroke: var(--k-cloud); }

  .dvi-svg .t-primary { fill: var(--color-text); }
  .dvi-svg .t-muted   { fill: var(--color-text-dim); }
  .dvi-svg .t-dim     { fill: var(--color-text-dim); }
  .dvi-svg .t-frontend   { fill: var(--k-frontend); }
  .dvi-svg .t-security   { fill: var(--k-security); }
  .dvi-svg .t-database   { fill: var(--k-database); }
  .dvi-svg .t-backend    { fill: var(--k-backend); }
  .dvi-svg .t-messagebus { fill: var(--k-messagebus); }
  .dvi-svg .t-external   { fill: var(--k-external); }
  .dvi-svg .t-cloud      { fill: var(--color-text-soft); }

  .dvi-svg .semantic-sigil { fill: none; stroke: currentColor; stroke-width: 1.35; stroke-linecap: round; stroke-linejoin: round; opacity: 0.8; }
  .dvi-svg .semantic-sigil > * { vector-effect: non-scaling-stroke; }
  .dvi-svg .semantic-sigil .sigil-fill { fill: currentColor; stroke: none; }
  .dvi-svg .s-frontend   { color: var(--k-frontend); }
  .dvi-svg .s-security   { color: var(--k-security); }
  .dvi-svg .s-database   { color: var(--k-database); }
  .dvi-svg .s-backend    { color: var(--k-backend); }
  .dvi-svg .s-messagebus { color: var(--k-messagebus); }
  .dvi-svg .s-external   { color: var(--k-external); }
  .dvi-svg .s-cloud      { color: var(--k-cloud); }

  /* Relationships. In the harness map: emphasis = shared, dashed = similar,
     security = missing on one side. Patterns differ as well as hues. */
  .dvi-svg .a-default  { stroke: var(--color-text-dim); fill: none; }
  .dvi-svg .a-emphasis { stroke: var(--color-accent); fill: none; }
  .dvi-svg .a-dashed   { stroke: var(--color-thread); fill: none; stroke-dasharray: 4 4; }
  .dvi-svg .a-security { stroke: var(--color-signal); fill: none; stroke-dasharray: 7 4; }
  .dvi-svg[data-diagram^='harness-map'] .a-emphasis { stroke-width: 3; }
  .dvi-svg .m-default  { fill: var(--color-text-dim); }
  .dvi-svg .m-emphasis { fill: var(--color-accent); }
  .dvi-svg .m-dashed   { fill: var(--color-thread); }
  .dvi-svg .m-security { fill: var(--color-signal); }

  /* Relationship labels reuse t-* classes by variant, not by node kind. */
  .dvi-svg g[data-edge-from] text.t-backend    { fill: var(--color-accent); }
  .dvi-svg g[data-edge-from] text.t-messagebus { fill: var(--color-thread); }
  .dvi-svg g[data-edge-from] text.t-security   { fill: var(--color-signal); }
  .dvi-svg g[data-edge-from] text.t-muted      { fill: var(--color-text-dim); }
  .dvi-svg g[data-edge-from] text { font-weight: 600; }
</style>
