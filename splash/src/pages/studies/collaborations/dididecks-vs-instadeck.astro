        {/* Hand-authored, as on silo-to-silo-01: a 2×2 of prose cells with
            depth meters, reflowing to one column on a phone. Each row carries
            two arrows here, because lessons run both ways in both layers. */}
        <figure class="lm" aria-describedby="dvi-lm-summary">
          <p id="dvi-lm-summary" class="lm__summary">
            dididecks-ai generates decks inside an operator’s Claude Code session, so its developer harness doubles as its
            product harness: deep in context, moderate in the product. Instadeck generates decks in a server pipeline a customer
            starts, so its product harness is deep, and its developer harness is moderate and walled off from the product on purpose.
          </p>
          <div class="lm__grid">
            <div class="lm__corner" aria-hidden="true"></div>
            <div class="lm__colhead lm__colhead--ours">dididecks-ai</div>
            <div class="lm__colgap" aria-hidden="true"></div>
            <div class="lm__colhead lm__colhead--them">Instadeck</div>
            {layers.map((L, i) => (
              <Fragment>
                <div class={`lm__rowhead lm__rowhead--${i}`}>
