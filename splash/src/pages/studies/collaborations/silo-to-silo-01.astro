    </nav>

    <!-- 2 · Layer map (centerpiece) ─────────────────────────────────── -->
    <section class="layermap" id="ch-layermap" aria-labelledby="s2s-layermap">
      <div class="container">
        <p class="eyebrow">ch · the layer map</p>
