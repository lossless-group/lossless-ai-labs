// ─── Insights and recommendations (step 2 §6, §7) ─────────────────────────
type Layer = 'Dev' | 'Product' | 'Both';
const insightsOurs: { layer: Layer; exception?: boolean; t: string; d: string }[] = [
  { layer: 'Product', t: 'We verify the code around the model, not the model.', d: 'Our checks ask whether a memo is true. Theirs also ask whether the system would say the same thing twice, and whether it ranks a known-strong input above a known-weak one.' },
  { layer: 'Product', t: 'We suppress variance where they measure it.', d: 'Pinning the writer to temperature 0 hides variance without telling us how large it is. Three averaged grading passes, plus a flip rate, tell them.' },
  { layer: 'Product', t: 'Craft knowledge compounds better in one ledger.', d: 'For bugs, one file per issue is right. For product craft, an ID-stable ledger with a “not yet distilled” tier and a per-run log compounds in a way 36 scattered files don’t.' },
  { layer: 'Product', t: 'The convergences confirm our product bets.', d: 'Assemble, don’t generate; a rulebook with addressable rules; run records on disk; human gates before generation. A silo with none of our conventions reached all four.' },
  { layer: 'Dev', exception: true, t: 'A command enforces; a loop doc only describes.', d: 'Their best workflow is one invocable file with a tool list and hard stops. Our dev loops are better written, but an agent has to be told to read them.' },
  { layer: 'Dev', t: 'We’re overbuilt where layers pile up without pruning.', d: 'Spec Kit beside context-v, four instruction files in the orchestrator, diverged skill copies, undiscoverable project skills, stale paths. None is serious alone.' },
  { layer: 'Dev', t: 'Committing settings.local.json is our slip, not theirs.', d: 'They kept the local file local. We track it in two repos.' },
  { layer: 'Dev', t: 'Our dev memory depends on infrastructure.', d: 'The Chroma server was down for this very comparison. Markdown plus git log can’t go down.' },
  { layer: 'Both', t: 'Both silos prototype product agents in the coding harness.', d: '/exam-build became /studio; our triage skill became a slab in augment-it’s in-app agent. On both sides it lacks a sync rule.' },
];
