          <figcaption class="s2s-figure__title">Lossless · in-product loop</figcaption>
          <div class="s2s-figure__svg s2s-scroll" tabindex="0" role="region" aria-label="The Lossless in-product loop, scrollable" set:html={loopProductOursSvg} />
        </figure>
