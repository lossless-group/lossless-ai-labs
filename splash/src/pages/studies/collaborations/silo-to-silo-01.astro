  { layer: 'Dev', exception: true, t: 'Epistemic tags and “start here” sections in specs,', d: 'plus a written model-routing rule for coding sessions.', from: 'From their measurement design and architecture doc.', size: 'S' },
  { layer: 'Dev', exception: true, t: 'A pruning pass on our dev harness.', d: 'Retire legacy harness files, untrack settings.local.json, reconcile diverged skills, link project skills, fix stale paths, decide Spec Kit’s future.', from: 'Prompted by their one-place harness, by contrast.', size: 'S–M' },
];
const insightsThem: { layer: Layer; exception?: boolean; t: string; d: string }[] = [
  { layer: 'Dev', t: 'The harness around your best work is almost all defaults.', d: 'No repo-wide instruction file, and a permission allowlist nobody curated, frozen since 2026-08-20, that lets an agent push and deploy without asking. The permission allowlist held credentials.' },
  { layer: 'Dev', t: 'Two workflows, one front door.', d: 'Exam work opens with a session opener and /exam-build. Platform work starts cold, which probably explains the exploratory greps in the allowlist.' },
  { layer: 'Dev', t: 'Your dev discipline is real, just hard to find.', d: 'Signed-off specs, post-ship sections and measured commits are all there. They need a map, not a new system.' },
  { layer: 'Dev', t: 'The gates exist, but nothing makes them run.', d: 'Tests, a validator, a craft-index check and a deploy-drift check all run only when remembered.' },
  { layer: 'Dev', t: 'History has a hole, and stale context misleads.', d: 'One commit folds 16 days of work done “outside git” into a single commit, and TODO.md contradicts the repo. A short end-of-session habit prevents both.' },
  { layer: 'Dev', t: 'Your simplicity is an asset.', d: 'One repo, plain JavaScript, deny-all database rules, model choice in runtime config. Take only the small pieces.' },
  { layer: 'Product', t: 'Your product harness is ahead of ours, and of most we’ve seen.', d: 'Measuring the instrument before the exam, giving the reviewer error bars, and logging human sittings that “could not have come from a matrix” is rigorous evaluation practice.' },
  { layer: 'Product', exception: true, t: 'The /exam-build to /studio port needs a source-of-truth rule.', d: 'Two implementations of one flow will drift, and the template has already started.' },
];
const recsThem: { layer: Layer; exception?: boolean; t: string; d: string; from: string; size: string }[] = [
  { layer: 'Dev', t: 'Add a short root CLAUDE.md for platform work.', d: '40 to 80 lines: what the app is, a map of the API routes and libraries and the ordered front-end scripts, a line saying the old script is dead, how to test and verify, the rule that must never break (no --only functions against production), a pointer to docs/ and the exam session opener, who deploys and commits.', from: 'Worked example: memopop-ai/CLAUDE.md, minus the tree rules.', size: 'S' },
  { layer: 'Dev', t: 'Turn the allowlist into a policy.', d: 'Rotate the credentials it held. Cut it to the 20 to 30 commands you’re glad to have run without asking; move push, deploy and credential commands to “ask”; deny curl against production.', from: 'Honestly, we don’t have a good worked example; we plan to do this too.', size: 'S' },
  { layer: 'Dev', t: 'Run npm test in CI on every push.', d: 'One workflow: Node 22, npm ci, npm test, plus the exam validator over shipped exams. Keep live-model preflights manual.', from: 'Worked example: augment-it ci.yml and its “WHY THIS EXISTS” header.', size: 'S' },
  { layer: 'Dev', t: 'End every session with a handoff, platform sessions included.', d: 'First line states git state, then where things stand and the next step. Fold TODO.md into it. Save any browser drive that proved something.', from: 'Worked example: an augment-it Pickup handoff that opens “Nothing is uncommitted. Nothing is unpushed.”', size: 'S' },
  { layer: 'Product', exception: true, t: 'Name the source of truth between /exam-build and /studio.', d: 'One comment at the top of both saying which leads, then a small test in the style of your own craft-index check that fails when they disagree or the template falls behind.', from: 'Worked example: augment-it chat.ts (“the SKILL.md is the source of truth … update together”). Ours has the rule but no check, so yours would be better.', size: 'S' },
];
const layerPill = (l: Layer) => (l === 'Dev' ? 'pill--thread' : l === 'Product' ? 'pill--accent' : 'pill--soft');
const layerWord = (l: Layer) => (l === 'Dev' ? 'Dev layer' : l === 'Product' ? 'Product layer' : 'Both layers');
