          </p>
          <div class="lm__grid">
            <div class="lm__corner" aria-hidden="true"></div>
            <div class="lm__colhead lm__colhead--ours">Lossless</div>
            <div class="lm__colgap" aria-hidden="true"></div>
            <div class="lm__colhead lm__colhead--them">{THEM}</div>
            {layers.map((L, i) => (
