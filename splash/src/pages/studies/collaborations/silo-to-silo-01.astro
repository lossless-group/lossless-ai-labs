    padding: var(--space-5);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }
  .tile__label { font-family: var(--font__mono); font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-text-dim); }
  .tile__count { font-family: var(--font__display); font-size: 2.6rem; font-weight: 600; line-height: 1; color: var(--color-text); }
  .tile__of { font-family: var(--font__mono); font-size: 0.74rem; color: var(--color-text-dim); }
  .tile__gist { color: var(--color-text-soft); font-size: 0.92rem; }
  .tile .swatch { position: absolute; top: var(--space-5); right: var(--space-5); }
  .meter { display: block; height: 4px; background: var(--color-border); border-radius: var(--radius-pill); overflow: hidden; margin: var(--space-2) 0; }
  .meter span { display: block; height: 100%; background: var(--color-text-dim); }
  .tile--shared .meter span { background: var(--color-accent); }
  .tile--similar .meter span { background: var(--color-thread); }
  .tile--missing .meter span { background: var(--color-signal); }

  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: var(--space-5); }

  /* Line swatches: the same line language as the diagrams. Never the only
     signal: every swatch sits next to the bucket's name. */
  .swatch { display: inline-block; width: 2.2rem; height: 0; border-top: 3px solid var(--color-text-dim); vertical-align: middle; margin-right: var(--space-2); }
  .swatch--shared { border-top: 3px solid var(--color-accent); }
  .swatch--similar { border-top: 2px dashed var(--color-thread); }
  .swatch--missing { border-top: 2px dashed var(--color-signal); }
  .swatch--different { width: 0.9rem; height: 0.9rem; border: 1.5px solid var(--color-text-dim); border-radius: 2px; }

  .line-key {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    font-family: var(--font__mono);
    font-size: 0.76rem;
    color: var(--color-text-dim);
    margin-bottom: var(--space-4);
  }

  /* Figures */
  .s2s-figure { margin: 0 0 var(--space-8); }
  .s2s-figure__svg {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3);
  }
  .s2s-figure__title {
    font-family: var(--font__mono);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    margin-bottom: var(--space-2);
  }
  .s2s-figure figcaption:not(.s2s-figure__title) {
    margin-top: var(--space-3);
    font-size: 0.86rem;
    color: var(--color-text-dim);
  }
  .s2s-figure--map .s2s-figure__svg--wide { max-width: 60rem; margin: 0 auto; }

  /* Diagrams that can't stack scroll sideways inside their own box on a
     phone; the page itself never scrolls horizontally. */
  /* ─── Stack comparison ────────────────────────────────────────────── */
  .stack__scroll { overflow-x: auto; margin-bottom: var(--space-6); }
  .stack__table { width: 100%; min-width: 44rem; border-collapse: collapse; font-size: 0.86rem; }
  .stack__table th, .stack__table td { text-align: left; vertical-align: top; padding: var(--space-2) var(--space-3); border-bottom: 1px solid var(--color-border-strong); color: var(--color-text-soft); }
  .stack__table thead th { font-family: var(--font__mono); font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text); border-bottom: 2px solid var(--color-accent); }
  .stack__table thead th:nth-child(2) { border-bottom-color: var(--color-signal); }
  .stack__table tbody th { font-family: var(--font__mono); font-size: 0.75rem; color: var(--color-text); white-space: nowrap; }
  .stack__table strong { color: var(--color-text); }
  .stack__grid { display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); margin-bottom: var(--space-6); }
  .stack__card { background: var(--color-bg-card); border: 1px solid var(--color-border-strong); border-left-width: 3px; border-radius: var(--radius-md); padding: var(--space-5); }
  .stack__card--them { border-left-color: var(--color-signal); }
  .stack__card--ours { border-left-color: var(--color-accent); }
  .stack__card h3 { font-size: 1rem; margin: 0 0 var(--space-3); color: var(--color-text); }
  .stack__card ul { margin: 0; padding-left: 1.1rem; display: grid; gap: var(--space-2); }
  .stack__card li { color: var(--color-text-soft); font-size: 0.9rem; }
  .stack__card strong { color: var(--color-text); }
  .tradeoff__title { font-size: 1.15rem; margin: var(--space-8) 0 var(--space-2); color: var(--color-text); }
  .tradeoff__lede { color: var(--color-text-soft); max-width: 72ch; margin-bottom: var(--space-4); }
  .tradeoff__verdict { color: var(--color-text-soft); max-width: 72ch; margin-bottom: var(--space-4); }
  .tradeoff__verdict strong, .tradeoff__verdict code { color: var(--color-text); }
  /* ─── Chapter cards + rail (from mpstaton-site's proposal pattern) ─── */
  .chapter-cards { display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr)); margin-top: var(--space-8); }
  .chapter-card { display: flex; flex-direction: column; gap: var(--space-2); padding: var(--space-4); border: 1px solid var(--color-border-strong); border-radius: var(--radius-md); background: color-mix(in oklab, var(--color-bg-card) 60%, transparent); text-decoration: none; transition: border-color 0.15s, background-color 0.15s, transform 0.15s; }
  .chapter-card:hover { border-color: color-mix(in oklab, var(--color-accent) 50%, var(--color-border-strong)); background: var(--color-bg-card); transform: translateY(-1px); }
  .chapter-card__num { font-family: var(--font__mono); font-size: 0.68rem; letter-spacing: 0.18em; color: var(--color-accent); font-variant-numeric: tabular-nums; }
  .chapter-card__title { font-family: var(--font__display); font-weight: 600; font-size: 1rem; line-height: 1.25; color: var(--color-text); text-wrap: balance; }
  .chapter-card__summary { font-size: 0.8rem; line-height: 1.5; color: var(--color-text-dim); text-wrap: pretty; }
  .chapter-rail { position: sticky; top: 64px; z-index: 20; background: color-mix(in oklab, var(--color-bg) 88%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--color-border); }
  .chapter-rail__inner { display: flex; gap: var(--space-1); overflow-x: auto; scrollbar-width: none; max-width: 76rem; margin: 0 auto; padding: var(--space-2) var(--space-6); }
  .chapter-rail__inner::-webkit-scrollbar { display: none; }
  .chapter-rail__item { flex: 0 0 auto; display: inline-flex; align-items: baseline; gap: var(--space-2); padding: 0.3rem 0.6rem; border-radius: var(--radius-sm); font-size: 0.75rem; line-height: 1.2; color: var(--color-text-dim); text-decoration: none; white-space: nowrap; transition: color 0.15s, background-color 0.15s; }
  .chapter-rail__item:hover { color: var(--color-text); background: color-mix(in oklab, var(--color-text) 8%, transparent); }
  .chapter-rail__item[aria-current='true'] { color: var(--color-text); background: color-mix(in oklab, var(--color-accent) 16%, transparent); }
  .chapter-rail__num { font-family: var(--font__mono); font-size: 0.68rem; letter-spacing: 0.08em; font-variant-numeric: tabular-nums; color: var(--color-accent); }
  .s2s > section[id^='ch-'] { scroll-margin-top: calc(64px + 3.25rem); }
  .s2s-scroll { overflow-x: auto; }
  .s2s-scroll :global(svg) { min-width: 44rem; }
  .s2s-scroll :global(svg[data-diagram='shape']) { min-width: 60rem; }

  /* Harness map: SVG on wide screens, stacked pairs on narrow ones. */
  .map-stack { display: none; }
  @media (max-width: 47.99rem) {
    .s2s-figure__svg--wide { display: none; }
    .map-stack { display: grid; gap: var(--space-5); }
  }
  .map-stack__cat { font-family: var(--font__mono); font-size: 0.74rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text-dim); margin-bottom: var(--space-2); }
  .map-stack ul { list-style: none; display: grid; gap: var(--space-2); }
  .pair {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-text-dim);
    border-radius: var(--radius-md);
  }
  .pair--shared { border-left: 3px solid var(--color-accent); }
  .pair--similar { border-left: 3px dashed var(--color-thread); }
  .pair--missing { border-left: 3px dashed var(--color-signal); }
  .pair__side { display: grid; font-size: 0.92rem; color: var(--color-text); }
  .pair__side small { font-family: var(--font__mono); font-size: 0.72rem; color: var(--color-text-dim); }
  .pair__who { font-family: var(--font__mono); font-size: 0.66rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text-dimmer); }
  .pair__bucket { font-family: var(--font__mono); font-size: 0.72rem; color: var(--color-text-soft); }
  .pair--shared .pair__bucket { color: var(--color-accent); }
  .pair--similar .pair__bucket { color: var(--color-thread); }
  .pair--missing .pair__bucket { color: var(--color-signal); }

  .loop-notes, .two-col { display: grid; gap: var(--space-4) var(--space-8); grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); margin-bottom: var(--space-6); }
  .loop-notes p, .two-col p { color: var(--color-text-soft); }

  /* Buckets */
  .bucket { padding: var(--space-8) 0; border-top: 1px dashed var(--color-border); }
  .bucket:first-of-type { border-top: none; }
  .bucket__head { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-3) var(--space-5); margin-bottom: var(--space-3); }
  .bucket__head h3 { font-size: 1.5rem; }
  .bucket__badge { font-family: var(--font__mono); font-size: 0.78rem; color: var(--color-text-dim); }
  .bucket__summary { font-family: var(--font__display); font-size: 1.08rem; color: var(--color-text); max-width: 68ch; }
  .prose { max-width: 72ch; }
  .prose p { color: var(--color-text-soft); }
  .prose code, .two-col code, .loop-notes code { color: var(--color-text); overflow-wrap: anywhere; }
  q { quotes: '\201C' '\201D'; color: var(--color-text); }

  .ledger { margin-top: var(--space-4); max-width: 72rem; }
  .ledger summary { cursor: pointer; font-family: var(--font__mono); font-size: 0.8rem; color: var(--color-thread); }
  .ledger table { width: 100%; border-collapse: collapse; margin-top: var(--space-3); font-size: 0.86rem; table-layout: fixed; }
  .ledger th, .ledger td { text-align: left; vertical-align: top; padding: var(--space-2) var(--space-3); border-bottom: 1px solid var(--color-border); overflow-wrap: anywhere; }
  .ledger th { font-family: var(--font__mono); font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-dim); font-weight: 500; }
  .ledger th:first-child, .ledger td:first-child { width: 4.2rem; font-family: var(--font__mono); color: var(--color-text-dim); }
  .ledger td { color: var(--color-text-soft); }

  /* Recommendations */
  .recs__cols { display: grid; gap: var(--space-8); grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); }
  .recs__col { padding: var(--space-6); background: var(--color-bg-card); border: 1px solid var(--color-border); border-top: 3px solid var(--color-accent); border-radius: var(--radius-md); }
  .recs__col--theirs { border-top-color: var(--color-signal); }
  .recs__col h3 { margin-bottom: var(--space-4); }
  .recs__col h3 .pill { font-size: 0.82rem; }
  .recs__col h4 { font-family: var(--font__mono); font-size: 0.74rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text-dim); margin: var(--space-5) 0 var(--space-3); }
  .insights, .ranked { padding-left: 1.4rem; display: grid; gap: var(--space-3); color: var(--color-text-soft); font-size: 0.94rem; }
  .insights strong, .ranked strong { color: var(--color-text); }
  .ranked li::marker { font-family: var(--font__mono); color: var(--color-accent); }
  .recs__col--theirs .ranked li::marker { color: var(--color-signal); }
  .ranked__meta { display: block; margin-top: var(--space-1); font-family: var(--font__mono); font-size: 0.74rem; color: var(--color-text-dim); }
  .recs__note { margin-top: var(--space-4); font-size: 0.86rem; color: var(--color-text-dim); }

  .steps { padding-left: 1.4rem; display: grid; gap: var(--space-2); color: var(--color-text-soft); margin-bottom: var(--space-4); }

  /* 16px gutter on phones */
  @media (max-width: 40rem) {
    .container { padding: 0 16px; }
    .recs__col { padding: var(--space-4); }
    .recs__cols { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<style is:global>
  /* ─── Archify class → splash token mapping ───────────────────────────
     Archify emits semantic classes; these rules bind them to theme.css
     tokens so the diagrams follow dark / light / vibrant. Category hues:
     instructions = thread, config = signal, context = accent,
     verification = neutral, git = accent-deep, people/shape = dim. */
  .s2s-svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font__mono);
    --k-frontend: var(--color-thread);
    --k-security: var(--color-signal);
    --k-database: var(--color-accent);
    --k-backend: var(--color-text-soft);
    --k-messagebus: var(--color-accent-deep);
    --k-external: var(--color-text-dim);
    --k-cloud: var(--color-text-soft);
  }
  .s2s-svg .c-grid { display: none; }
  .s2s-svg .c-mask { fill: var(--color-bg-elevated); stroke: none; }
  .s2s-svg .c-region { fill: color-mix(in oklab, var(--color-text) 3%, transparent); stroke: var(--color-border-strong); stroke-dasharray: 8 4; }
  .s2s-svg .c-security-group { fill: transparent; stroke: var(--k-security); stroke-dasharray: 4 4; }
  .s2s-svg .c-lane { fill: color-mix(in oklab, var(--color-text) 3%, transparent); stroke: var(--color-border-strong); stroke-dasharray: 6 6; }

  .s2s-svg .c-frontend   { fill: color-mix(in oklab, var(--k-frontend) 14%, var(--color-bg-elevated));   stroke: var(--k-frontend); }
  .s2s-svg .c-security   { fill: color-mix(in oklab, var(--k-security) 14%, var(--color-bg-elevated));   stroke: var(--k-security); }
  .s2s-svg .c-database   { fill: color-mix(in oklab, var(--k-database) 14%, var(--color-bg-elevated));   stroke: var(--k-database); }
  .s2s-svg .c-backend    { fill: color-mix(in oklab, var(--k-backend) 10%, var(--color-bg-elevated));    stroke: var(--k-backend); }
  .s2s-svg .c-messagebus { fill: color-mix(in oklab, var(--k-messagebus) 16%, var(--color-bg-elevated)); stroke: var(--k-messagebus); }
  .s2s-svg .c-external   { fill: var(--color-bg-elevated); stroke: var(--k-external); }
  .s2s-svg .c-cloud      { fill: var(--color-bg-elevated); stroke: var(--k-cloud); }

  .s2s-svg .t-primary { fill: var(--color-text); }
  .s2s-svg .t-muted   { fill: var(--color-text-dim); }
  .s2s-svg .t-dim     { fill: var(--color-text-dim); }
  .s2s-svg .t-frontend   { fill: var(--k-frontend); }
  .s2s-svg .t-security   { fill: var(--k-security); }
  .s2s-svg .t-database   { fill: var(--k-database); }
  .s2s-svg .t-backend    { fill: var(--k-backend); }
  .s2s-svg .t-messagebus { fill: var(--k-messagebus); }
  .s2s-svg .t-external   { fill: var(--k-external); }
  .s2s-svg .t-cloud      { fill: var(--color-text-soft); }

  .s2s-svg .semantic-sigil { fill: none; stroke: currentColor; stroke-width: 1.35; stroke-linecap: round; stroke-linejoin: round; opacity: 0.8; }
  .s2s-svg .semantic-sigil > * { vector-effect: non-scaling-stroke; }
  .s2s-svg .semantic-sigil .sigil-fill { fill: currentColor; stroke: none; }
  .s2s-svg .s-frontend   { color: var(--k-frontend); }
  .s2s-svg .s-security   { color: var(--k-security); }
  .s2s-svg .s-database   { color: var(--k-database); }
  .s2s-svg .s-backend    { color: var(--k-backend); }
  .s2s-svg .s-messagebus { color: var(--k-messagebus); }
  .s2s-svg .s-external   { color: var(--k-external); }
  .s2s-svg .s-cloud      { color: var(--k-cloud); }

  /* Relationships. In the harness map: emphasis = shared, dashed = similar,
     security = missing on one side. Patterns differ as well as hues. */
  .s2s-svg .a-default  { stroke: var(--color-text-dim); fill: none; }
  .s2s-svg .a-emphasis { stroke: var(--color-accent); fill: none; }
  .s2s-svg .a-dashed   { stroke: var(--color-thread); fill: none; stroke-dasharray: 4 4; }
  .s2s-svg .a-security { stroke: var(--color-signal); fill: none; stroke-dasharray: 7 4; }
  .s2s-svg[data-diagram^='harness-map'] .a-emphasis { stroke-width: 3; }
  .s2s-svg .m-default  { fill: var(--color-text-dim); }
  .s2s-svg .m-emphasis { fill: var(--color-accent); }
  .s2s-svg .m-dashed   { fill: var(--color-thread); }
  .s2s-svg .m-security { fill: var(--color-signal); }

  /* Relationship labels reuse t-* classes by variant, not by node kind. */
  .s2s-svg g[data-edge-from] text.t-backend    { fill: var(--color-accent); }
  .s2s-svg g[data-edge-from] text.t-messagebus { fill: var(--color-thread); }
  .s2s-svg g[data-edge-from] text.t-security   { fill: var(--color-signal); }
  .s2s-svg g[data-edge-from] text.t-muted      { fill: var(--color-text-dim); }
  .s2s-svg g[data-edge-from] text { font-weight: 600; }
</style>
