          {CHAPTERS.map((c) => (
            <a class="chapter-card" href={`#${c.id}`}>
              <span class="chapter-card__num">{c.num}</span>
              <span class="chapter-card__title">{c.title}</span>
              <span class="chapter-card__summary">{c.summary}</span>
            </a>
          ))}
        </nav>
      </div>
    </section>

    <nav class="chapter-rail" aria-label="Chapter navigation" data-chapter-rail>
      <div class="chapter-rail__inner">
        {CHAPTERS.map((c) => (
          <a class="chapter-rail__item" href={`#${c.id}`} data-rail-target={c.id}>
