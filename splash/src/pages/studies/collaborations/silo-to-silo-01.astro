  { layer: 'Product', t: 'Measure run-to-run reliability.', d: 'Replay one section N times on frozen inputs; report verdict flip rate and score spread. Make evaluate_memo.py report a standard error.', from: 'From their gate replay and reviewer error bars.', size: 'M' },
