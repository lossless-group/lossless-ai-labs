// ─── Harness maps stacked for narrow screens ──────────────────────────────
// Derived from the same Archify sources as the SVGs, so the two never drift.
type Comp = { id: string; type: string; label: string; sublabel?: string; pos: number[] };
type MapDoc = { meta: { legend: { entries: Record<string, { label: string }> } }; components: Comp[]; connections: { from: string; to: string; label?: string }[] };
function stackFrom(doc: MapDoc) {
  const byId = new Map(doc.components.map((c) => [c.id, c]));
  const pairs = doc.components
    .filter((c) => c.id.startsWith('l-'))
    .map((l) => {
      const conn = doc.connections.find((k) => k.from === l.id);
      return { y: l.pos[1], category: doc.meta.legend.entries[l.type]?.label ?? '', ours: l, them: conn ? byId.get(conn.to) : undefined, bucket: conn?.label ?? 'no counterpart' };
    })
    .sort((a, b) => a.y - b.y);
  return [...new Set(pairs.map((p) => p.category))].map((cat) => ({ cat, rows: pairs.filter((p) => p.category === cat) }));
}
const stacks = { dev: stackFrom(mapDev as MapDoc), product: stackFrom(mapProduct as MapDoc) };
const bucketClass = (b: string) =>
  b === 'shared' ? 'shared' : b === 'similar' ? 'similar' : b.startsWith('missing') ? 'missing' : 'different';

