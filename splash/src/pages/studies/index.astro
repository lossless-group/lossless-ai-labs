---
/**
 * /studies/ — landing page for the pinned reading collections.
 *
 * Data flow: `pnpm rollup:sync` snapshots each study's `.gitmodules` (the
 * authoritative pinned-repo list) and its README question into
 * src/rollup/studies.json. This page reads that snapshot, never the study
 * submodules themselves: CI builds with `submodules: false`, so reading them
 * here rendered "0 pinned" and no questions on the live site.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import { readFile } from 'node:fs/promises';
import { resolve } from 'node:path';

const base = import.meta.env.BASE_URL;

interface PinnedRepo {
  /** Local slug = the submodule path inside the study dir. */
  slug: string;
  /** Canonical web URL (https://github.com/owner/name — no .git). */
  url: string;
  owner: string;
  name: string;
}

interface Study {
  number: string;
  slug: string;
  title: string;
  /** The question this study scopes — pulled from the README's first blockquote. */
  question: string;
  studyRepoUrl: string;
  pinned: PinnedRepo[];
}

interface StudySnapshot {
  dir: string;
  question: string;
  pinned: PinnedRepo[];
}

/** Presentation order and display titles. A study in the snapshot but not in
 *  this list still renders, after these, under its directory name. */
const STUDY_ORDER: { dir: string; title: string }[] = [
  { dir: 'open-specs-and-standards',                    title: 'Open Specs & Standards' },
  { dir: 'memory-layers-for-agents',                    title: 'Memory Layers for Agents' },
  { dir: 'data-analytics-specifications-and-standards', title: 'Data-Analytics Specs & Standards' },
  { dir: 'markdown-parse-serve-render',                 title: 'Markdown: Parse, Serve, Render' },
  { dir: 'vector-databases',                            title: 'Vector Databases' },
  { dir: 'agent-harnesses',                             title: 'Agent Harnesses' },
  { dir: 'conversational-ui-and-native-shells',         title: 'Conversational UI & Native Shells' },
  { dir: 'sync-and-content-version-control',            title: 'Sync & Content Version Control' },
  { dir: 'frontend-ui-kits-component-libraries',        title: 'Frontend UI Kits & Component Libraries' },
];

const snapshot: StudySnapshot[] = JSON.parse(
  await readFile(resolve(process.cwd(), 'src', 'rollup', 'studies.json'), 'utf8').catch(() => '[]'),
);
const rank = (dir: string) => {
  const i = STUDY_ORDER.findIndex((s) => s.dir === dir);
  return i === -1 ? STUDY_ORDER.length : i;
};

const studies: Study[] = [...snapshot]
  .sort((a, b) => rank(a.dir) - rank(b.dir) || a.dir.localeCompare(b.dir))
  .map((s, i) => ({
    number: String(i + 1).padStart(2, '0'),
    slug: s.dir,
    title: STUDY_ORDER.find((o) => o.dir === s.dir)?.title ?? s.dir,
    question: s.question,
    studyRepoUrl: `https://github.com/lossless-group/study-${s.dir}`,
    pinned: s.pinned,
  }));

const totalPinned = studies.reduce((acc, s) => acc + s.pinned.length, 0);

/** Collaboration studies: a small hand-maintained list (not pinned upstreams). */
const COLLABORATIONS: { slug: string; title: string; note: string }[] = [
  { slug: 'silo-to-silo-01', title: 'Silo to Silo 01', note: 'Lossless beside a single-app Firebase repo · 2026-10-03' },
  { slug: 'dididecks-vs-instadeck', title: 'Dididecks vs Instadeck', note: 'Two deck generators from one lineage, two approaches · 2026-10-03' },
];
---

<BaseLayout title="Studies">
  <section class="hero">
    <div class="container">
      <p class="eyebrow">ch · studies</p>
      <h1>Pinned reading,<br /><span class="gradient-text">not paraphrase.</span></h1>
      <p class="lede">
        Each study scopes one domain question and pins upstream code as nested
        git submodules. We read from the pinned source — not from training data,
        not from a paraphrase, not from a blog post that aged out a year ago.
      </p>
      <ul class="meta-strip" role="list">
        <li><strong>{studies.length}</strong>&nbsp;studies</li>
        <li><strong>{totalPinned}</strong>&nbsp;pinned repos</li>
        <li><strong>read</strong>&nbsp;from source</li>
      </ul>
    </div>
  </section>

  {studies.map((study) => (
    <section class="study" id={study.slug}>
      <div class="container">
        <header class="study__head">
          <p class="eyebrow">study · {study.number}</p>
          <h2 class="study__title">{study.title}</h2>
          {study.question && (
            <blockquote class="study__question">{study.question}</blockquote>
          )}
        </header>

        <div class="study__meta">
          <span class="pill pill--accent">{study.pinned.length} pinned</span>
          <a class="study__repo-link" href={study.studyRepoUrl} target="_blank" rel="noopener">
            study repo&nbsp;→
          </a>
          <a class="study__anchor" href={`${base}studies/#${study.slug}`} aria-label="Permalink to this study">
            #{study.slug}
          </a>
        </div>

        <ul class="pinned-grid" aria-label={`Pinned repositories for ${study.title}`}>
          {study.pinned.map((r) => (
            <li class="pinned-card">
              <a href={r.url} class="pinned-card__link" target="_blank" rel="noopener">
                <span class="pinned-card__slug">{r.slug}</span>
                <span class="pinned-card__source">
                  <span class="pinned-card__owner">{r.owner}</span><span class="pinned-card__sep">/</span><span class="pinned-card__name">{r.name}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <section class="study" id="collaborations">
    <div class="container">
      <header class="study__head">
        <p class="eyebrow">collaborations</p>
        <h2 class="study__title">Collaborations</h2>
        <blockquote class="study__question">
          Silo against silo: when a friend has built their own agentic-coding harness next
          to ours, what can each side learn from the other?
        </blockquote>
      </header>
      {/* Hand-maintained. Collaborators stay anonymous: generic titles only. */}
      <ul class="pinned-grid" aria-label="Collaboration studies">
        {COLLABORATIONS.map((c) => (
          <li class="pinned-card">
            <a href={`${base}studies/collaborations/${c.slug}/`} class="pinned-card__link">
              <span class="pinned-card__slug">{c.title}</span>
              <span class="pinned-card__source"><span class="pinned-card__name">{c.note}</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="outro">
    <div class="container">
      <p class="eyebrow">ch · why pin</p>
      <h2>Why pin upstream code instead of bookmarking it?</h2>
      <div class="grid grid--why">
        <article class="bench-card">
          <span class="bench-card__label">grounded</span>
          <div class="bench-card__body">
            <h3>The agent reads source, not training-data folklore.</h3>
            <p>When a decision touches a convention someone else already worked out, the answer comes from the pinned repo — not from whatever the model half-remembers.</p>
          </div>
        </article>
        <article class="bench-card">
          <span class="bench-card__label">stable</span>
          <div class="bench-card__body">
            <h3>SHA-pinned. Doesn't rot under us.</h3>
            <p>A study's submodule points at a specific commit. When we revisit a study six months later, the same source is still there. Upgrades are explicit, not silent.</p>
          </div>
        </article>
        <article class="bench-card">
          <span class="bench-card__label">scoped</span>
          <div class="bench-card__body">
            <h3>One study, one question.</h3>
            <p>Studies are not a general reading list. Each one scopes a single domain question and pins only what helps answer it. New questions get new studies, not pile-ons.</p>
          </div>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: var(--space-16) 0 var(--space-12);
  }
  .hero h1 {
    margin-top: var(--space-3);
    margin-bottom: var(--space-5);
  }
  .hero .lede {
    margin-bottom: var(--space-6);
    max-width: 60ch;
  }

  .study {
    padding: var(--space-12) 0;
    border-top: 1px solid var(--color-border);
  }

  .study__head {
    margin-bottom: var(--space-6);
  }
  .study__title {
    margin: var(--space-2) 0 var(--space-4);
  }
  .study__question {
    margin: 0;
    padding: var(--space-3) var(--space-5);
    border-left: 2px solid var(--color-accent);
    background: var(--color-bg-soft);
    color: var(--color-text-soft);
    font-family: var(--font__display);
    font-size: 1.05rem;
    font-style: italic;
    line-height: 1.5;
    max-width: 70ch;
  }

  .study__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-4);
    margin-bottom: var(--space-6);
    font-family: var(--font__mono);
    font-size: 0.78rem;
    color: var(--color-text-dim);
  }
  .study__repo-link {
    color: var(--color-accent);
    text-decoration: none;
  }
  .study__repo-link:hover {
    text-decoration: underline;
  }
  .study__anchor {
    color: var(--color-text-dimmer);
    text-decoration: none;
    margin-left: auto;
  }
  .study__anchor:hover {
    color: var(--color-text-dim);
  }

  .pinned-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-3);
  }

  .pinned-card {
    margin: 0;
  }

  .pinned-card__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    color: inherit;
    text-decoration: none;
    transition: border-color 120ms ease, background 120ms ease, transform 120ms ease;
  }
  .pinned-card__link:hover {
    border-color: var(--color-border-accent);
    background: var(--color-bg-elevated);
    transform: translateY(-1px);
  }

  .pinned-card__slug {
    font-family: var(--font__mono);
    font-size: 0.88rem;
    color: var(--color-text);
    word-break: break-word;
  }

  .pinned-card__source {
    font-family: var(--font__mono);
    font-size: 0.72rem;
    color: var(--color-text-dim);
    display: inline-flex;
    align-items: baseline;
    flex-wrap: wrap;
  }
  .pinned-card__sep {
    opacity: 0.4;
    padding: 0 0.2em;
  }
  .pinned-card__owner {
    opacity: 0.75;
  }
  .pinned-card__name {
    color: var(--color-text-soft);
  }

  .outro {
    padding: var(--space-12) 0 var(--space-16);
    border-top: 1px solid var(--color-border);
  }
  .outro h2 {
    margin: var(--space-2) 0 var(--space-6);
  }
  .grid--why {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-4);
  }
</style>
