    { "id": "factcheck-evaluate", "from": "factcheck", "to": "evaluate", "variant": "emphasis" },
    { "id": "evaluate-analyst", "from": "evaluate", "to": "analyst" },
    { "id": "evaluate-missing", "from": "evaluate", "to": "missing", "variant": "security" },
    { "id": "evaluate-lessons", "from": "evaluate", "to": "lessons", "label": "lessons", "variant": "emphasis" }
