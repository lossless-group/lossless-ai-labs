    { "id": "branch-tests", "from": "branch", "to": "tests", "variant": "emphasis" },
    { "id": "tests-pr", "from": "tests", "to": "pr", "variant": "emphasis" },
    { "id": "pr-records", "from": "pr", "to": "records" },
    { "id": "pr-deploy", "from": "pr", "to": "deploy", "variant": "emphasis" },
    { "id": "records-titles", "from": "records", "to": "titles", "variant": "dashed" }
